# /opt/guilda-sentinela/sentinela.env  (chmod 600 — tem o token do bot)

# Telegram: crie o bot no @BotFather e pegue o chat id com @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp (opcional): qualquer webhook que receba {"to": "...", "text": "..."}.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_TO=

# IPs que podem entrar no SSH sem disparar alerta (separados por vírgula).
SSH_ALLOW_IPS=

# Resumo diário: hora em UTC (12 = 9h de Brasília).
DIGEST_HOUR_UTC=12

# Alerta quando passar disso de cadastros numa hora.
SIGNUP_BURST=15

CADDY_LOG=/var/log/caddy/guilda-access.log
CONTAINER=guilda-web
PROD_ENV=/opt/gypsi-guilda/secrets/production.env
